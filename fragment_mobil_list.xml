<!-- res/layout/fragment_mobil_list.xml -->
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daftar Mobil"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMobil1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Toyota Avanza - Lihat Detail" />

        <Button
            android:id="@+id/btnMobil2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Honda Brio - Lihat Detail" />

        <Button
            android:id="@+id/btnMobil3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Toyota Innova - Lihat Detail" />

    </LinearLayout>
</ScrollView>
