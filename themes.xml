        <item name="colorSecondary">@color/marine_secondary</item>
        <item name="colorOnSecondary">@color/marine_on_secondary</item>
        <item name="colorTertiary">@color/marine_tertiary</item>
        <item name="colorOnTertiary">@color/marine_on_tertiary</item>

        <item name="android:colorBackground">@color/marine_background</item>
        <item name="colorOnBackground">@color/marine_on_background</item>
        <item name="colorSurface">@color/marine_surface</item>
        <item name="colorOnSurface">@color/marine_on_surface</item>

        <item name="colorError">@color/marine_error</item>
